{
  "name": "sitemap-analyzer",
  "version": "1.0.0",
  "description": "Cross-platform desktop SEO crawler & site auditor. Sitemap or spider mode, per-URL SEO / Performance / Content / Technical / Social / Images / Links analysis with weighted health score, problems panel, redirect & gzip / HTTP-3 detection, interactive site tree, sitemap generator and CSV / XLSX / HTML / PNG / SVG / JSON / GEXF exports.",
  "author": "SpiderSEO",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint && npm run test",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^4.5.0",
    "image-size": "^2.0.2",
    "jszip": "^3.10.1",
    "minimatch": "^10.2.5",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.10.8",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "d3": "^7.9.0",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.9",
    "vitest": "^2.1.9",
    "zustand": "^5.0.0"
  }
}
